{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "connect-gem",
  "compatibility_date": "2026-09-19",
  "main": "src/worker/index.ts",
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "RoomDO" }]
  },
  // SQLite-backed is required for Durable Objects to work on the free plan.
  // new_classes (KV-backed) requires a paid plan and will fail to deploy.
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["RoomDO"] }],
  "observability": {
    "enabled": true
  }
}
